{
  "format": "yk-schema-db",
  "version": 1,
  "scope": "database",
  "database": {
    "en_name": "telecom_catalog_admin",
    "zh_name": "電信商品上架管理資料庫",
    "description": "參考 CSMU 專案資料庫導覽架構，供前端網頁管理商品分類、內容、圖片、規格、品牌與發布狀態；不含任何業務資料。",
    "sort_order": 5
  },
  "groups": [
    {
      "id": 1,
      "en_name": "catalog_core",
      "zh_name": "商品目錄",
      "description": "商品分類、上架主檔與分類關聯。",
      "sort_order": 1
    },
    {
      "id": 2,
      "en_name": "content_publishing",
      "zh_name": "內容發布",
      "description": "商品內容、區塊、圖片與規格。",
      "sort_order": 2
    },
    {
      "id": 3,
      "en_name": "brand_marketing",
      "zh_name": "品牌與行銷",
      "description": "品牌資料與促銷商品關聯。",
      "sort_order": 3
    }
  ],
  "subgroups": [],
  "tables": [
    {
      "id": 50001,
      "group_id": 1,
      "subgroup_id": 0,
      "en_name": "catalog_categories",
      "zh_name": "商品分類",
      "table_type": "table",
      "description": "前端商品導覽的單一分類樹；最多四層，禁止循環。 category_code、slug 唯一；parent_id 與 sort_order 支援樹狀排序。",
      "sort_order": 1
    },
    {
      "id": 50002,
      "group_id": 1,
      "subgroup_id": 0,
      "en_name": "catalog_products",
      "zh_name": "上架商品主檔",
      "table_type": "table",
      "description": "前端商品與服務的發布主檔，保存草稿、排程、上架與封存狀態。 product_code、slug 唯一；來源只能是方案、庫存品項或一般商品三者之一。",
      "sort_order": 2
    },
    {
      "id": 50003,
      "group_id": 1,
      "subgroup_id": 0,
      "en_name": "catalog_product_categories",
      "zh_name": "商品分類關聯",
      "table_type": "table",
      "description": "商品與分類的多對多關聯，並指定一個主要分類。 product_id + category_id 唯一；每個商品最多一個主要分類。",
      "sort_order": 3
    },
    {
      "id": 50004,
      "group_id": 2,
      "subgroup_id": 0,
      "en_name": "catalog_product_content",
      "zh_name": "商品內容與 SEO",
      "table_type": "table",
      "description": "依語系保存商品標題、摘要、內文與搜尋引擎欄位。 product_id + locale 唯一。",
      "sort_order": 4
    },
    {
      "id": 50005,
      "group_id": 2,
      "subgroup_id": 0,
      "en_name": "catalog_product_sections",
      "zh_name": "商品內容區塊",
      "table_type": "table",
      "description": "依順序組合商品介紹、特色與注意事項區塊。 product_id + locale + section_key 唯一。",
      "sort_order": 5
    },
    {
      "id": 50006,
      "group_id": 2,
      "subgroup_id": 0,
      "en_name": "catalog_product_media",
      "zh_name": "商品媒體",
      "table_type": "table",
      "description": "保存商品主圖、圖庫、圖示與橫幅的網址、替代文字與排序。 每個商品最多一張主圖；網址只允許站內絕對路徑或 HTTPS。",
      "sort_order": 6
    },
    {
      "id": 50007,
      "group_id": 2,
      "subgroup_id": 0,
      "en_name": "catalog_product_specs",
      "zh_name": "商品規格",
      "table_type": "table",
      "description": "依語系與規格群組保存結構化商品規格。 product_id + spec_key + locale 唯一。",
      "sort_order": 7
    },
    {
      "id": 50008,
      "group_id": 3,
      "subgroup_id": 0,
      "en_name": "catalog_brands",
      "zh_name": "品牌主檔",
      "table_type": "table",
      "description": "前端可重複使用的品牌名稱、說明、網站與標誌。 brand_code、slug 唯一。",
      "sort_order": 8
    },
    {
      "id": 50009,
      "group_id": 3,
      "subgroup_id": 0,
      "en_name": "catalog_product_brands",
      "zh_name": "商品品牌關聯",
      "table_type": "table",
      "description": "商品與品牌的多對多關聯，並指定主要品牌。 product_id + brand_id 唯一；每個商品最多一個主要品牌。",
      "sort_order": 9
    },
    {
      "id": 50010,
      "group_id": 3,
      "subgroup_id": 0,
      "en_name": "catalog_promotion_products",
      "zh_name": "活動適用商品",
      "table_type": "table",
      "description": "促銷活動與前端上架商品的關聯。 promotion_id + product_id 唯一。",
      "sort_order": 10
    }
  ],
