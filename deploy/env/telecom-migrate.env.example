# MySQL schema migration account. Do not use the runtime account here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=intern_migrate
DB_PASSWORD=CHANGE_ME
TELECOM_DB_NAME=telecom_boss

# Existing, readable, non-empty mysqldump created immediately before migration.
# Example: /var/backups/telecom-site/telecom_boss-before-catalog-v2.sql
MYSQL_MIGRATION_BACKUP_PATH=/var/backups/telecom-site/telecom_boss-before-catalog-v2.sql

# Named-lock wait time in seconds.
DB_TRANSACTION_LOCK_TIMEOUT=15
